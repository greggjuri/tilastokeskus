# Copy to .env and fill in. .env is gitignored — never commit real values.
# Alternatively these may live in ~/.config/tilastokeskus/.

# ---- Yahoo Fantasy Sports API ----
# Issued by Yahoo after the Fantasy API access application is approved.
# https://sports.yahoo.com/developer/access/
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=https://localhost:8000

# ---- PostgreSQL ----
# tilasto_app is the read/write role used by the collector.
# Grafana connects separately as tilasto_ro and must never hold these credentials.
PGHOST=localhost
PGPORT=5432
PGDATABASE=tilastokeskus
PGUSER=tilasto_app
PGPASSWORD=

# ---- Collector ----
# Default season. Yahoo game keys are season-scoped; override per run with --season
# to backfill prior seasons that Yahoo still retains for the account.
TILASTO_SEASON=2026
# Directory for gzipped raw API responses, written before parsing.
TILASTO_RAW_DIR=raw
